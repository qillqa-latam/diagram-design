{
  "name": "@qillqa-latam/diagram-design",
  "version": "1.0.0",
  "description": "Editorial diagrams your designer won't hate. Reusable TypeScript library with 39 diagram types, 7 semantic patterns, and 4px grid orthogonal routing.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "diagram-design": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.cjs"
    },
    "./diagrams": {
      "types": "./dist/diagrams/index.d.ts",
      "import": "./dist/diagrams/index.js",
      "require": "./dist/diagrams/index.cjs"
    },
    "./semantic-patterns": {
      "types": "./dist/semantic-patterns/index.d.ts",
      "import": "./dist/semantic-patterns/index.js",
      "require": "./dist/semantic-patterns/index.cjs"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js",
      "require": "./dist/renderers/index.cjs"
    },
    "./linter": {
      "types": "./dist/linter/index.d.ts",
      "import": "./dist/linter/index.js",
      "require": "./dist/linter/index.cjs"
    },
    "./importers": {
      "types": "./dist/importers/index.d.ts",
      "import": "./dist/importers/index.js",
      "require": "./dist/importers/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "vite playground",
    "dev:playground": "vite playground",
    "build:playground": "vite build playground --outDir ../dist-playground",
    "dev:docs": "vite docs --config docs/vite.config.ts",
    "build:docs": "vite build docs --config docs/vite.config.ts",
    "preview:docs": "vite preview docs --config docs/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "vitest run src/packaging.test.ts",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --from=HEAD~1",
    "prepare": "husky",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test && pnpm run test:pack",
    "release:check": "pnpm run build && pnpm run test && pnpm run test:pack && npm pack --dry-run"
  },
  "keywords": [
    "diagram",
    "architecture",
    "svg",
    "editorial",
    "sankey",
    "flowchart",
    "sequence",
    "database-schema",
    "radar",
    "treemap",
    "typescript"
  ],
  "author": "qillqa-latam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qillqa-latam/diagram-design.git"
  },
  "homepage": "https://qillqa-latam.github.io/diagram-design/",
  "bugs": {
    "url": "https://github.com/qillqa-latam/diagram-design/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
